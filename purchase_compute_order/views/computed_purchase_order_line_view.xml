<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_computed_purchase_order_line_tree" model="ir.ui.view">
        <field name="name">computed.purchase.order.line.list</field>
        <field name="model">computed.purchase.order.line</field>
        <field name="arch" type="xml">
            <list
                string="Computed purchase order lines"
                editable="bottom"
                create="0"
                edit="0"
                delete="0"
            >
                <field name="computed_purchase_order_id" />
                <field name="product_id" />
                <field name="qty_available" />
                <field name="incoming_qty" />
                <field name="displayed_average_consumption" />
                <field name="uom_id" />
                <field name="stock_duration" />
                <field
                    name="product_packaging_id"
                    groups="product.group_stock_packaging"
                />
                <field
                    name="purchase_qty_package"
                    groups="product.group_stock_packaging"
                />
                <field name="package_qty" groups="product.group_stock_packaging" />
                <field name="purchase_qty" />
                <field name="product_price" />
                <field name="discount" />
                <field name="price_policy" groups="product.group_stock_packaging" />
                <field name="shelf_life" />
                <field name="virtual_duration" />
                <field name="subtotal" />
                <field name="state" />
                <button
                    name="unlink_psi"
                    invisible="state not in ('up_to_date', 'updated')"
                    type="object"
                    icon="fa-close"
                    title="If you click this button,
                            it means you don't want to buy this
                            product to this supplier anymore.
                            The supplier will thus be removed from
                            the product form."
                />
                <button
                    name="create_psi"
                    invisible="state != 'new'"
                    type="object"
                    icon="fa-plus-square"
                    title="If you click this button,
                            it means you want to buy this product
                            to this supplier regularly.
                            The supplier will thus be added to
                            the product form."
                />
            </list>
        </field>
    </record>

    <record id="view_computed_purchase_order_line_form" model="ir.ui.view">
        <field name="name">computed.purchase.order.line.form</field>
        <field name="model">computed.purchase.order.line</field>
        <field name="arch" type="xml">
            <form string="Computed purchase order lines" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" readonly="1" />
                            <field name="product_code" />
                            <field
                                name="price_policy"
                                groups="product.group_stock_packaging"
                            />
                            <field name="shelf_life" />
                            <field name="qty_available" />
                            <field name="incoming_qty" />
                            <field name="outgoing_qty" />
                            <field name="stock_duration" />
                            <field name="virtual_duration" />
                            <field name="displayed_average_consumption" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="psi_id"
                                string="Vendor Pricelist"
                                readonly="1"
                            />
                            <field
                                name="product_packaging_id"
                                readonly="cpo_state != 'draft'"
                                groups="product.group_stock_packaging"
                            />
                            <field
                                name="purchase_qty_package"
                                readonly="cpo_state != 'draft' or not product_packaging_id"
                                groups="product.group_stock_packaging"
                            />
                            <field
                                name="package_qty"
                                groups="product.group_stock_packaging"
                            />
                            <field
                                name="purchase_qty"
                                readonly="cpo_state != 'draft' or product_packaging_id"
                            />
                            <field name="uom_po_id" />
                            <field name="product_price" />
                            <field name="discount" />
                            <field name="subtotal" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-warning="state == 'updated'"
                                decoration-info="state == 'new'"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_computed_purchase_order_line_search" model="ir.ui.view">
        <field name="name">computed.purchase.order.line.search</field>
        <field name="model">computed.purchase.order.line</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Order Lines">
                <field name="product_id" />
                <field name="state" />
                <field name="purchase_qty" />
                <filter
                    name="ordered_products"
                    string="Ordered Products"
                    domain="[('purchase_qty','>',0)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Product"
                        name="grp_product"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        string="Status"
                        name="grp_state"
                        context="{'group_by':'state'}"
                    />
                    <filter
                        string="CPO Status"
                        name="grp_cpo_state"
                        context="{'group_by':'cpo_state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_computed_purchase_order_tree" model="ir.actions.act_window">
        <field name="name">Computed Purchase Order Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">computed.purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_computed_purchase_order_line_tree" />
    </record>
</odoo>
